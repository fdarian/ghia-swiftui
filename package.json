{
	"name": "ghia-swiftui-workspace",
	"private": true,
	"packageManager": "pnpm@12.16.1",
	"scripts": {
		"format": "biome check --write",
		"check": "turbo run check",
		"start": "pnpm --filter ghia-swiftui-demo start",
		"screenshot": "pnpm --filter ghia-swiftui-demo screenshot",
		"live-capture": "pnpm --filter ghia-swiftui-demo live-capture",
		"glass-check": "pnpm --filter ghia-swiftui-demo glass-check",
		"window-check": "pnpm --filter ghia-swiftui-demo window-check",
		"reference": "pnpm --filter ghia-swiftui-reference capture",
		"compare": "pnpm --filter ghia-swiftui-reference compare",
		"ci:version": "changeset version",
		"ci:release": "pnpm --filter ghia-swiftui build && pnpm --filter ghia-swiftui-demo release:binary && changeset publish"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"@changesets/cli": "3.0.3",
		"turbo": "2.11.10"
	}
}
