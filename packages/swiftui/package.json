{
	"name": "ghia-swiftui",
	"version": "0.2.0",
	"description": "SwiftUI-style component library for ghia: native macOS controls, glass, and design tokens on GPUI.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fdarian/ghia-swiftui.git",
		"directory": "packages/swiftui"
	},
	"license": "MIT",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./tokens/*": "./src/tokens/*.ts",
		"./native-glass": "./src/native-glass.ts",
		"./objc": "./src/objc.ts"
	},
	"imports": {
		"#src/*": "./src/*"
	},
	"scripts": {
		"build": "tsdown",
		"check:type": "tsc",
		"check:lint": "biome check"
	},
	"dependencies": {
		"ghia-base-ui": "0.1.1"
	},
	"peerDependencies": {
		"@ghia/solid": "0.12.1",
		"solid-js": "1.9.15"
	},
	"devDependencies": {
		"@ghia/native": "0.12.1",
		"@ghia/solid": "0.12.1",
		"@total-typescript/tsconfig": "1.0.4",
		"@types/bun": "1.4.4",
		"rolldown-plugin-solid": "0.2.1",
		"solid-js": "1.9.15",
		"tsdown": "0.23.5",
		"typescript": "7.0.2",
		"vite": "8.3.7"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"publishConfig": {
		"bin": {
			"ghia-swiftui": "./dist/cli.js"
		},
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js"
			},
			"./tokens/*": {
				"types": "./dist/tokens/*.d.ts",
				"import": "./dist/tokens/*.js"
			},
			"./native-glass": {
				"types": "./dist/native-glass.d.ts",
				"import": "./dist/native-glass.js"
			},
			"./objc": {
				"types": "./dist/objc.d.ts",
				"import": "./dist/objc.js"
			}
		}
	}
}
