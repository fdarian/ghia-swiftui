{
	"extends": "@total-typescript/tsconfig/bundler/no-dom/app",
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"noErrorTruncation": true,
		"jsx": "preserve",
		"jsxImportSource": "@ghia/solid",
		"types": ["bun"]
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx",
		"scripts/**/*.ts",
		"scripts/**/*.tsx"
	]
}
